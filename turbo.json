{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": [
                "^build"
            ]
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".wrangler/**",
                "target/**",
                ".next/**"
            ],
            "env": [
                "!NEXT_PUBLIC_*",
                "NEXT_PUBLIC_STACK_PROJECT_ID",
                "NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY",
                "STACK_SECRET_SERVER_KEY"
            ]
        },
        "deploy": {
            "dependsOn": [
                "build",
                "test",
                "lint"
            ],
            "cache": false
        },
        "test": {
            "dependsOn": [
                "^build"
            ]
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "format": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "clean": {
            "cache": false
        },
        "cf-typegen": {
            "outputs": [
                "**/*.d.ts"
            ]
        },
        "start": {
            "cache": false,
            "persistent": true,
            "dependsOn": [
                "^build"
            ]
        }
    },
    "globalDependencies": [
        "package.json",
        "turbo.json",
        "tsconfig.json",
        "biome.json"
    ],
    "globalEnv": [
        "NODE_ENV"
    ]
}
